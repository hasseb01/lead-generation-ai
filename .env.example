# Database — local dev default (SQLite, zero setup)
DATABASE_URL="file:./dev.db"
# Production: Postgres via Supabase, e.g.
# DATABASE_URL="postgresql://postgres:<password>@<project>.supabase.co:5432/postgres"

# Google Places API key (Text Search + Place Details).
# If unset, the app falls back to bundled mock company data so it still runs end-to-end.
GOOGLE_PLACES_API_KEY=

# OpenAI API key, used for text-embedding-3-small similarity scoring.
# If unset, the scoring engine falls back to a token-overlap similarity heuristic.
OPENAI_API_KEY=

# Upstash Redis (serverless), used to cache Places API responses by (industry, location).
# If unset, an in-memory cache is used instead (fine for local dev / demo).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
